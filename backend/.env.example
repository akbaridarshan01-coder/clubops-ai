# ClubOps AI Backend Configuration
PORT=5000
DATABASE_URL="file:./dev.db"

# JWT Configuration
JWT_SECRET="clubops-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Redis Configuration (Optional in local dev, auto-falls back to in-memory queue/cache)
REDIS_URL="redis://localhost:6379"

# AI Provider Configuration (Optional, falls back to built-in deterministic heuristic AI engine)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

NODE_ENV="development"

# ==========================================
# Email OTP Provider Configuration (SMTP)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="ClubOps AI <your-email@gmail.com>"

# ==========================================
# Mobile SMS OTP Provider Configuration (Fast2SMS)
# ==========================================
FAST2SMS_API_KEY="your-fast2sms-api-key"
