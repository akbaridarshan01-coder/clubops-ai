datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  mobile          String?        @unique
  passwordHash    String?
  name            String
  avatar          String?
  role            String         @default("ORGANIZER") // ORGANIZER, MEMBER, ADMIN
  verifiedEmail   Boolean        @default(false)
  verifiedMobile  Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  clubsOwned      Club[]         @relation("ClubOwner")
  clubMemberships ClubMember[]
  tasksAssigned   Task[]         @relation("TaskAssignee")
  volunteers      Volunteer[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  aiActions       AiAction[]     @relation("ActionProposedBy")
  aiConversations AiConversation[]

  @@index([email])
  @@index([mobile])
}

model OtpVerification {
  id          String   @id @default(uuid())
  identifier  String   // email or mobile number
  hashedCode  String
  type        String   // EMAIL_VERIFY, MOBILE_VERIFY, LOGIN
  attempts    Int      @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([identifier, type])
}

model Club {
  id          String       @id @default(uuid())
  name        String
  college     String
  category    String       // Technical, Cultural, Sports, Literary, Entrepreneurship, Social, Other
  description String?
  logo        String?
  joinCode    String       @unique
  ownerId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner       User         @relation("ClubOwner", fields: [ownerId], references: [id])
  members     ClubMember[]
  teams       Team[]
  events      Event[]
  volunteers  Volunteer[]
  documents   Document[]
  activityLogs ActivityLog[]

  @@index([ownerId])
  @@index([joinCode])
}

model ClubMember {
  id        String   @id @default(uuid())
  clubId    String
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, LEAD, VOLUNTEER, MEMBER
  joinedAt  DateTime @default(now())

  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

model Team {
  id          String   @id @default(uuid())
  clubId      String
  name        String   // Core, Technical, Logistics, Sponsorship, Marketing, Hospitality
  color       String   @default("#6366F1")
  description String?
  leadId      String?
  createdAt   DateTime @default(now())

  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tasks       Task[]
  volunteers  Volunteer[]

  @@index([clubId])
}

model Event {
  id                   String        @id @default(uuid())
  clubId               String
  name                 String
  type                 String        // Hackathon, Tech Fest, Cultural Fest, Workshop, Seminar, etc.
  date                 DateTime
  endDate              DateTime?
  expectedParticipants Int           @default(500)
  location             String
  budget               Float         @default(0)
  status               String        @default("PLANNING") // PLANNING, ACTIVE, WAR_ROOM, COMPLETED
  healthScore          Int           @default(85)
  currentMilestone     String?
  description          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  club                 Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tasks                Task[]
  meetings             Meeting[]
  risks                Risk[]
  documents            Document[]
  announcements        Announcement[]
  metrics              EventMetric[]
  aiActions            AiAction[]
  activityLogs         ActivityLog[]

  @@index([clubId])
  @@index([status])
}

model Task {
  id             String           @id @default(uuid())
  eventId        String
  teamId         String?
  title          String
  description    String?
  status         String           @default("TODO") // TODO, IN_PROGRESS, BLOCKED, IN_REVIEW, DONE
  priority       String           @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  assigneeId     String?
  deadline       DateTime
  estimatedHours Float            @default(4)
  actualHours    Float            @default(0)
  riskLevel      String           @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  tags           String?          // JSON array of strings
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team           Team?            @relation(fields: [teamId], references: [id])
  assignee       User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dependencies   TaskDependency[] @relation("TaskRequires")
  dependedOnBy   TaskDependency[] @relation("TaskPrerequisite")

  @@index([eventId])
  @@index([teamId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([deadline])
}

model TaskDependency {
  id               String   @id @default(uuid())
  taskId           String   // The task that is waiting
  dependsOnTaskId  String   // The prerequisite task
  type             String   @default("FINISH_TO_START") // FINISH_TO_START, START_TO_START
  createdAt        DateTime @default(now())

  task             Task     @relation("TaskRequires", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn        Task     @relation("TaskPrerequisite", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
}

model Volunteer {
  id              String           @id @default(uuid())
  clubId          String
  userId          String?
  teamId          String?
  name            String
  email           String
  phone           String?
  skills          String?          // JSON array of strings: ["React", "Stage Management", "Social Media"]
  availability    String           @default("AVAILABLE") // AVAILABLE, BUSY, UNAVAILABLE
  experienceYears Float            @default(1.0)
  rating          Float            @default(4.5)
  currentWorkload String           @default("LOW") // LOW, MEDIUM, HIGH, OVERLOADED
  assignedHours   Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  club            Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id])
  team            Team?            @relation(fields: [teamId], references: [id])
  skillRecords    VolunteerSkill[]

  @@index([clubId])
  @@index([teamId])
  @@index([availability])
  @@index([currentWorkload])
}

model VolunteerSkill {
  id          String    @id @default(uuid())
  volunteerId String
  skillName   String
  proficiency Int       @default(3) // 1-5

  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@index([skillName])
}

model Meeting {
  id          String              @id @default(uuid())
  eventId     String
  title       String
  date        DateTime            @default(now())
  location    String?
  transcript  String
  summary     String?
  processedAt DateTime?
  createdAt   DateTime            @default(now())

  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actionItems MeetingActionItem[]

  @@index([eventId])
}

model MeetingActionItem {
  id                String   @id @default(uuid())
  meetingId         String
  rawText           String
  extractedTitle    String
  suggestedOwner    String?
  suggestedDeadline DateTime?
  suggestedPriority String   @default("MEDIUM")
  suggestedTeam     String?
  convertedTaskId   String?
  createdAt         DateTime @default(now())

  meeting           Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Risk {
  id             String   @id @default(uuid())
  eventId        String
  title          String
  description    String
  category       String   // VENUE, BUDGET, VOLUNTEER, TECHNICAL, TIMELINE, SPONSOR
  severity       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status         String   @default("IDENTIFIED") // IDENTIFIED, MITIGATING, RESOLVED
  impactAnalysis String?
  mitigationPlan String?
  affectedTasks  String?  // JSON array of task IDs
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([severity])
  @@index([status])
}

model Document {
  id          String          @id @default(uuid())
  clubId      String
  eventId     String?
  title       String
  fileUrl     String
  fileType    String          // PDF, DOCX, TXT, IMAGE
  fileSize    Int
  category    String          // BUDGET, GUIDELINE, REPORT, CONTRACT, MINUTES, SCHEDULE
  summary     String?
  content     String?         // Extracted text
  createdAt   DateTime        @default(now())

  club        Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event       Event?          @relation(fields: [eventId], references: [id])
  chunks      DocumentChunk[]

  @@index([clubId])
  @@index([eventId])
  @@index([category])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  content    String
  pageNumber Int      @default(1)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Announcement {
  id           String    @id @default(uuid())
  eventId      String
  title        String
  channel      String    // WHATSAPP, EMAIL, NOTICE, INSTAGRAM
  content      String
  targetAudience String  @default("ALL") // VOLUNTEERS, PARTICIPANTS, SPONSORS, ALL
  status       String    @default("DRAFT") // DRAFT, SENT, SCHEDULED
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([channel])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  eventId   String?
  category  String   // TASK, RISK, MEETING, AI, SYSTEM, WAR_ROOM
  title     String
  message   String
  read      Boolean  @default(false)
  actionUrl String?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(uuid())
  clubId     String?
  eventId    String?
  userId     String?
  action     String   // CREATED_TASK, APPROVED_AI_ACTION, MITIGATED_RISK, etc.
  entityType String   // TASK, RISK, EVENT, VOLUNTEER, MEETING
  entityId   String?
  details    String?  // JSON string
  createdAt  DateTime @default(now())

  club       Club?    @relation(fields: [clubId], references: [id])
  event      Event?   @relation(fields: [eventId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([clubId])
  @@index([eventId])
  @@index([createdAt])
}

model AiAction {
  id           String    @id @default(uuid())
  eventId      String
  proposedById String?
  actionType   String    // REASSIGN_TASKS, CREATE_FOLLOWUP, NOTIFY_TEAM, ACTIVATE_CONTINGENCY, ALLOCATE_VOLUNTEERS
  title        String
  description  String
  payload      String    // JSON string containing target entities and operations
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXECUTED
  executedAt   DateTime?
  auditLog     String?
  createdAt    DateTime  @default(now())

  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  proposedBy   User?     @relation("ActionProposedBy", fields: [proposedById], references: [id])

  @@index([eventId])
  @@index([status])
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  eventId   String?
  title     String      @default("Copilot Session")
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  sender         String         // USER, ASSISTANT, SYSTEM
  content        String
  actionPayload  String?        // JSON string of proposed actions
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model EventMetric {
  id             String   @id @default(uuid())
  eventId        String
  timestamp      DateTime @default(now())
  healthScore    Int
  completedTasks Int
  totalTasks     Int
  criticalRisks  Int
  activeVolunteers Int

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([timestamp])
}
